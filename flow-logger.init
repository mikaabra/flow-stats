#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
    grep -q "net.core.rmem_max=16777216" /etc/sysctl.d/99-flow-logger.conf 2>/dev/null || \
        echo "net.core.rmem_max=16777216" > /etc/sysctl.d/99-flow-logger.conf
    sysctl -w net.core.rmem_max=16777216 >/dev/null
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/local/bin/flow-logger.py
    procd_set_param respawn 3600 5 5
    procd_set_param nice 19
    procd_set_param stderr 1
    procd_set_param stdout 1
    procd_close_instance
}
